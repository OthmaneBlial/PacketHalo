[Unit]
Description=PacketHalo ambient network observatory
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/packethalo
EnvironmentFile=/opt/packethalo/.env.appliance
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f appliance/docker-compose.appliance.yml up -d --build
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f appliance/docker-compose.appliance.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
