# PacketHalo is loopback-only by default. Set LAN mode deliberately.
PACKETHALO_HOST=127.0.0.1
PACKETHALO_PORT=8787
# Required when PACKETHALO_HOST is not loopback.
PACKETHALO_CONTROL_TOKEN=
# Local SQLite metadata store and retention window (1 to 10080 minutes).
PACKETHALO_DATABASE=packethalo.db
PACKETHALO_RETENTION_MINUTES=60
# Browser display stream. Production containers use the same-origin proxy.
VITE_PACKET_HALO_SERVER=ws://127.0.0.1:8787/stream
# Headless simulator ingestion endpoint. Public endpoints require HTTPS and an
# explicit PACKETHALO_ALLOW_REMOTE=1 opt-in.
PACKETHALO_SERVER=http://127.0.0.1:8787/api/events
PACKETHALO_ALLOW_REMOTE=0
